<QueryList>
  <Query Id="0" Path="Security">
    <!-- Kirjautumiset, Explicit Creds (4648), Admin-oikeudet (4672), RDP-istunnot -->
    <Select Path="Security">*[System[(EventID=4624 or EventID=4625 or EventID=4648 or EventID=4672 or EventID=4778 or EventID=4779)]]</Select>
    <!-- Paikallinen tunnus- ja ryhmähallinta -->
    <Select Path="Security">*[System[(EventID=4720 or EventID=4722 or EventID=4724 or EventID=4725 or EventID=4726 or EventID=4732 or EventID=4733 or EventID=4741)]]</Select>
    <!-- Prosessien luonti (vaatii GPO: Include command line) -->
    <Select Path="Security">*[System[(EventID=4688)]]</Select>
    <!-- Ajastetut tehtävät täydellä XML-sisällöllä -->
    <Select Path="Security">*[System[(EventID=4698 or EventID=4702)]]</Select>
    <!-- Lokien tyhjennys, uudet palvelut, auditointipolitiikka, kellonaika (4616), jaot (5142, 5144) -->
    <Select Path="Security">*[System[(EventID=1102 or EventID=4616 or EventID=4697 or EventID=4719 or EventID=5142 or EventID=5144)]]</Select>
  </Query>

  <Query Id="1" Path="System">
    <!-- Palvelut (7045, 7040), lokin tyhjennys (104), käynnistykset ja sammutukset (1074, 6005, 6006, 6008) -->
    <Select Path="System">*[System[(EventID=104 or EventID=1074 or EventID=6005 or EventID=6006 or EventID=6008 or EventID=7040 or EventID=7045)]]</Select>
  </Query>

  <Query Id="2" Path="Application">
    <!-- MSI-asennukset (mm. etähallintatyökalut / RMM) -->
    <Select Path="Application">*[System[Provider[@Name='MsiInstaller'] and (EventID=1033 or EventID=1040 or EventID=11707)]]</Select>
  </Query>

  <Query Id="3" Path="Microsoft-Windows-PowerShell/Operational">
    <!-- Module Logging (4103) ja Script Block Logging (4104) -->
    <Select Path="Microsoft-Windows-PowerShell/Operational">*[System[(EventID=4103 or EventID=4104)]]</Select>
  </Query>

  <Query Id="4" Path="Microsoft-Windows-Sysmon/Operational">
    <!-- Prosessit (1), Verkko (3), Palvelun tila (4), Ajurit (6), Injektio (8,10), Tiedostot/MOTW (11,15), Rekisteri (12-14), Config-muutos (16), Named Pipes (17,18), WMI (19-21), DNS (22), Tampering (25) -->
    <Select Path="Microsoft-Windows-Sysmon/Operational">*[System[(EventID=1 or EventID=3 or EventID=4 or EventID=6 or EventID=8 or EventID=10 or EventID=11 or EventID=12 or EventID=13 or EventID=14 or EventID=15 or EventID=16 or EventID=17 or EventID=18 or EventID=19 or EventID=20 or EventID=21 or EventID=22 or EventID=25)]]</Select>
  </Query>

  <Query Id="5" Path="Microsoft-Windows-TaskScheduler/Operational">
    <Select Path="Microsoft-Windows-TaskScheduler/Operational">*[System[(EventID=106 or EventID=140 or EventID=141 or EventID=200)]]</Select>
  </Query>

  <Query Id="6" Path="Microsoft-Windows-Windows Defender/Operational">
    <Select Path="Microsoft-Windows-Windows Defender/Operational">*[System[(EventID=1116 or EventID=1117 or EventID=5001 or EventID=5007)]]</Select>
  </Query>

  <Query Id="7" Path="Microsoft-Windows-WMI-Activity/Operational">
    <Select Path="Microsoft-Windows-WMI-Activity/Operational">*[System[(EventID=5857 or EventID=5858 or EventID=5859 or EventID=5860 or EventID=5861)]]</Select>
  </Query>

  <Query Id="8" Path="Microsoft-Windows-TerminalServices-LocalSessionManager/Operational">
    <!-- RDP-istuntojen aikajana (kirjautuminen, irrotus, uudelleenyhdistäminen) -->
    <Select Path="Microsoft-Windows-TerminalServices-LocalSessionManager/Operational">*[System[(EventID=21 or EventID=22 or EventID=23 or EventID=24 or EventID=25)]]</Select>
  </Query>

  <Query Id="9" Path="Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational">
    <!-- Saapuvan RDP-yhteyden lähde-IP -->
    <Select Path="Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational">*[System[(EventID=1149)]]</Select>
  </Query>

  <Query Id="10" Path="Microsoft-Windows-TerminalServices-RDPClient/Operational">
    <!-- Lähtevät RDP-yhteydet (lateraalinen liike lähdekoneelta) -->
    <Select Path="Microsoft-Windows-TerminalServices-RDPClient/Operational">*[System[(EventID=1024 or EventID=1102)]]</Select>
  </Query>

  <Query Id="11" Path="Microsoft-Windows-NTLM/Operational">
    <!-- NTLM-autentikoinnit (Pass-the-Hash) -->
    <Select Path="Microsoft-Windows-NTLM/Operational">*[System[(EventID=8004)]]</Select>
  </Query>

  <!-- LISÄARVOLÄHTEET (MATALA MELU, AKTIIVISET) -->

  <Query Id="12" Path="Windows PowerShell">
    <!-- PowerShell v2 -downgrade-hyökkäykset -->
    <Select Path="Windows PowerShell">*[System[(EventID=400 or EventID=600)]]</Select>
  </Query>

  <Query Id="13" Path="Microsoft-Windows-CodeIntegrity/Operational">
    <!-- Allekirjoittamattomat/haavoittuvat ajurit (BYOVD) ja WDAC -->
    <Select Path="Microsoft-Windows-CodeIntegrity/Operational">*[System[(EventID=3001 or EventID=3002 or EventID=3004 or EventID=3033 or EventID=3076 or EventID=3077)]]</Select>
  </Query>

  <Query Id="14" Path="Microsoft-Windows-LSA/Operational">
    <!-- LSASS-suojauksen (RunAsPPL) tila ja estetyt DLL-lataukset -->
    <Select Path="Microsoft-Windows-LSA/Operational">*</Select>
  </Query>

  <Query Id="15" Path="Microsoft-Windows-Windows Firewall With Advanced Security/Firewall">
    <!-- Palomuurisääntöjen lisäykset, muokkaukset ja poistot -->
    <Select Path="Microsoft-Windows-Windows Firewall With Advanced Security/Firewall">*[System[(EventID=2004 or EventID=2005 or EventID=2006)]]</Select>
  </Query>

  <!-- OPTIONAALISET LÄHTEET (POISTA KOMMENTIT AKTIVOIDAKSESI)
  <Query Id="16" Path="Microsoft-Windows-SMBServer/Security">
    <Select Path="Microsoft-Windows-SMBServer/Security">*</Select>
  </Query>

  <Query Id="17" Path="Microsoft-Windows-SMBClient/Security">
    <Select Path="Microsoft-Windows-SMBClient/Security">*</Select>
  </Query>
  -->
</QueryList>
