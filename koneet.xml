  </Query>

  <Query Id="1" Path="Microsoft-Windows-AppLocker/MSI and Script">
    <Select Path="Microsoft-Windows-AppLocker/MSI and Script">*[System[(EventID=8005 or EventID=8006 or EventID=8007)]]</Select>
  </Query>

  <Query Id="2" Path="Microsoft-Windows-Bits-Client/Operational">
