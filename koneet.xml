  </Query>

  <Query Id="6" Path="Microsoft-Windows-WinRM/Operational">
    <Select Path="Microsoft-Windows-WinRM/Operational">*[System[(EventID=6 or EventID=91 or EventID=169)]]</Select>
  </Query>
