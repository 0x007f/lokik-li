    <Select Path="Microsoft-Windows-DriverFrameworks-UserMode/Operational">*[System[(EventID=2003 or EventID=2100 or EventID=2101 or EventID=2102)]]</Select>
  </Query>

  <Query Id="5" Path="Security">
